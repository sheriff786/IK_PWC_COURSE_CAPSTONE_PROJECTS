      "doc_id": "TXN-002",
      "doc_version": "1",
      "heading": null,
      "heading_hint": null,
      "is_heading": false,
      "text": "1.2 The Original Agreement governs the supply of Embedded Processor Boards, Secure Communication Modules, and Cryptographic Controllers. This Renewal ensures continued supply, updated specifications, pricing, quality standards, and risk management measures for an additional two-year period.",
      "source_location": {
        "doc_id": "TXN-002",
        "kind": "paragraph",
        "locator": "paragraph:6",
        "excerpt": "1.2 The Original Agreement governs the supply of Embedded Processor Boards, Secure Communication Modules, and Cryptographic Controllers. This Renewal ensures continued supply, updated specifications, pricing, quality standards, and risk management measures for an additional two-year period."
      }
